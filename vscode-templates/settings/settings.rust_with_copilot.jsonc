{
  // ============================================================
  // Rust 言語設定（rust-analyzer）
  // ============================================================

  "rust-analyzer.server.path": null,
  "rust-analyzer.updates.channel": "stable",

  // 保存時に clippy を実行
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.check.command": "clippy",

  // proc-macro を有効化
  "rust-analyzer.procMacro.enable": true,

  // 自動インポート（auto-import）を明示的に有効化
  "rust-analyzer.completion.autoimport.enable": true,

  // インポート整理の粒度（crate 単位が最も安定）
  "rust-analyzer.imports.granularity.group": "crate",

  // インポート prefix（self が推奨）
  "rust-analyzer.imports.prefix": "self",

  // diagnostics を強化（未使用 import の検出など）
  "rust-analyzer.diagnostics.enable": true,
  "rust-analyzer.diagnostics.disabled": [],

  // ============================================================
  // フォーマット設定
  // ============================================================

  "editor.formatOnSave": true,

  // Rust 専用の import 整理設定
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },

  // ============================================================
  // Code Runner 設定
  // ============================================================

  "code-runner.executorMap": {
    "rust": "cd $dir && cargo run",
  },
  "code-runner.runInTerminal": true,

  // ============================================================
  // ファイル関連
  // ============================================================

  "files.exclude": {
    "**/target": true,
    "**/.cache": true,
  },
  "files.eol": "\n",
  "files.encoding": "utf8",

  // ============================================================
  // ターミナル設定（WSL2）
  // ============================================================

  "terminal.integrated.env.linux": {
    "PATH": "${env:HOME}/.cargo/bin:${env:PATH}",
  },

  // ============================================================
  // VSCode UI カスタマイズ
  // ============================================================

  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "Monokai",

  // ============================================================
  // Git 設定
  // ============================================================

  "git.autofetch": true,
  "git.autofetchPeriod": 180,

  // ============================================================
  // Markdown 専用設定
  // ============================================================

  "[markdown]": {
    "editor.insertSpaces": true,
    "editor.inlineSuggest.enabled": false,
    "editor.tabSize": 2,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false,
    },
    "editor.renderWhitespace": "boundary",
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
  },

  // ============================================================
  // Copilot（インライン補完を最大化）
  // ============================================================

  "editor.inlineSuggest.enabled": true,

  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "yaml": true,
    "json": true,
    "php": true,
    "go": true,
    "typescript": true,
    "rust": true,
  },

  "editor.suggest.showWords": false,
  "editor.suggest.showSnippets": false,
  "editor.suggest.showMethods": true,
  "editor.suggest.showFunctions": true,
  "editor.suggest.showVariables": true,

  // ============================================================
  // WSL2 安定化設定
  // ============================================================

  "remote.autoForwardPorts": false,
  "remote.WSL.fileWatcher.polling": true,
  "remote.WSL.fileWatcher.usePolling": true,
}
